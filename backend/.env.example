# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is gitignored — never commit real keys.

# --- OpenAI (direct, platform.openai.com) ---
OPENAI_API_KEY=sk-your-key-here
# Model to use. Defaults to gpt-4o-mini if omitted.
OPENAI_MODEL=gpt-4o-mini

# --- GCS storage for interaction logs ---
# Bucket name only (no gs:// prefix). If unset, storage is skipped (chat still works).
GCS_BUCKET=your-bucket-name
# Optional object-key prefix inside the bucket.
GCS_PREFIX=interactions
# Path to a service-account JSON key (local dev only).
# On Cloud Run, leave this unset — the runtime service account is used automatically.
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcs-key.json

# --- Calendly (E10 scheduling) ---
# Primary scheduling URL the agent sends to customers.
# Falls back to https://calendly.com/pipe-dreams-by-jill/consultation if unset.
CALENDLY_SCHEDULING_URL=https://calendly.com/pipe-dreams-by-jill/consultation
# Optional. Calendly event-type URI, only required if we wire the
# Calendly v2 event-type-specific APIs (not needed for MVP).
CALENDLY_EVENT_TYPE_URI=

# --- CORS ---
# Comma-separated list of allowed origins. "*" opens to everyone — fine
# for local development. Tighten to the deployed frontend URL in prod.
ALLOWED_ORIGINS=*
